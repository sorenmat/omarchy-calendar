{
  "schemaVersion": 1,
  "id": "smo.calendar",
  "name": "Calendar & Agenda",
  "version": "0.1.0",
  "author": "smo, tmn73, tobiasz-p",
  "license": "MIT",
  "description": "A month calendar and meeting agenda for multiple Google accounts.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Calendar & Agenda",
    "description": "Your Google Calendar in the bar. Your next meeting at a glance, and one click to join it.",
    "category": "Time",
    "allowMultiple": false,
    "defaults": {
      "format": "dddd HH:mm",
      "formatAlt": "d MMMM 'W'ww yyyy",
      "verticalFormat": "HH\n-\nmm",
      "startPulseMinutes": 3,
      "meetingMascot": true
    },
    "schema": [
      {
        "key": "meetingMascot",
        "type": "boolean",
        "label": "Walking cat at meeting start",
        "defaultValue": true
      },
      {
        "key": "startPulseMinutes",
        "type": "integer",
        "label": "Meeting start pulse (minutes, 0 = off)",
        "min": 0,
        "max": 60,
        "step": 1,
        "defaultValue": 3
      },
      {
        "key": "format",
        "type": "string",
        "label": "Date format",
        "defaultValue": "dddd HH:mm"
      },
      {
        "key": "formatAlt",
        "type": "string",
        "label": "Alternate format",
        "defaultValue": "d MMMM 'W'ww yyyy"
      },
      {
        "key": "verticalFormat",
        "type": "string",
        "label": "Vertical bar format",
        "defaultValue": "HH\n-\nmm"
      }
    ]
  }
}
